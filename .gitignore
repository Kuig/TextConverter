# =============================================================================
# TextConverter — .gitignore
# =============================================================================

# Credentials (NEVER commit these)
secrets.json
.env

# Note: config.json IS versioned on purpose. It holds no secrets, only
# app/provider defaults (models, prompts, timeouts), so it doubles as its
# own example file.

# Python bytecode and caches
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/
ENV/

# Distribution / packaging artifacts
build/
dist/
*.egg-info/
*.egg
MANIFEST
.eggs/
wheels/

# Test artifacts
.coverage
coverage.xml
htmlcov/
.tox/
tests/Output/

# Type checkers and linters
.mypy_cache/
.ruff_cache/

# IDEs and editors
.idea/
.vscode/
*.swp
*.swo
*~

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# Windows Registry files generated by the "Windows Integration" scripts
Windows Integration/register.reg
Windows Integration/unregister.reg

# Cora extension (local tool metadata, not versioned)
.cora/

# Claude Code local settings and agent guidance (not versioned)
.claude/
CLAUDE.md

# Project-specific: local output/scratch folders
Unused/
DocsInput/
DocsOutput/
